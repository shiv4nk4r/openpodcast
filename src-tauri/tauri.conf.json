{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPodcast",
  "version": "0.1.0",
  "identifier": "com.openpodcast.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPodcast",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/OpenPodcast/**",
          "$DATA/OpenPodcast/**",
          "$HOME/Library/Application Support/OpenPodcast/**",
          "$HOME/.local/share/OpenPodcast/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "signingIdentity": "Developer ID Application: Shivankar Sharma (NH6XX7B9AW)"
    }
  }
}
